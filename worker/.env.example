# Supabase (Project Settings > API). The service role key bypasses RLS: keep it secret, server-side only.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Worker tuning
WORKER_CONCURRENCY=2
WORKER_POLL_MS=2000
WORKER_MAX_ATTEMPTS=3

# GPU backend: mock | http | runpod
GPU_PROVIDER=runpod
GPU_TIMEOUT_MS=480000

# mock only: fraction of scenes that fail on purpose, to test retries and refunds
# MOCK_FAIL_RATE=0.2

# http provider (gpu-server/server.py on Vast.ai / any GPU box)
# GPU_ENDPOINT_URL=http://your-gpu-host:8000
# GPU_API_KEY=

# runpod provider (gpu-server/runpod_handler.py as a serverless endpoint)
RUNPOD_ENDPOINT_ID=your-endpoint-id
RUNPOD_API_KEY=your-runpod-api-key
